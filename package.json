{
  "name": "crewdesk",
  "version": "0.1.0",
  "private": true,
  "description": "Job management SaaS for field-service businesses",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=web",
    "dev:api": "npm run dev --workspace=api",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspace=web",
    "typecheck": "npm run typecheck --workspace=api",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:psql": "docker compose exec db psql -U crewdesk -d crewdesk_dev",
    "db:generate": "npm exec --workspace=api -- prisma generate",
    "db:migrate": "npm exec --workspace=api -- prisma migrate dev",
    "test": "npm run test --workspace=api"
  },
  "engines": {
    "node": ">=24"
  }
}
